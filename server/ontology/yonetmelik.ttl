# ═════════════════════════ Temel haklar ═════════════════════════

fy:IfadeOzgurlugu a fy:TemelHak ; rdfs:label "İfade özgürlüğü" ; fy:dayanak fy:Madde_4_2 ;
    rdfs:comment "Düşünce ve kanaatlerini söz, yazı veya başka yollarla açıklama ve yayma hakkı; eleştiri dahil." ;
    fy:anahtarKelime "ifade", "eleştiri", "yasaklansın", "susturulsun", "konuşma yasağı" .
fy:EsitlikAyrimcilikYasagi a fy:TemelHak ; rdfs:label "Eşitlik ve ayrımcılık yasağı" ; fy:dayanak fy:Madde_4_1 ;
    fy:cekirdekDegistirilemez true ;
    rdfs:comment "Herkesin dil, ırk, renk, cinsiyet, engellilik, siyasi düşünce, din, mezhep ve benzeri sebeplerle ayrım gözetilmeksizin eşit muamele görme hakkı. Özü oylanamaz." ;
    fy:anahtarKelime "yalnızca", "sadece", "hariç tutulsun", "giremesin", "ayrı tutulsun", "yabancılar", "kadınlar", "erkekler" .
fy:OzelHayatinGizliligi a fy:TemelHak ; rdfs:label "Özel hayatın gizliliği ve kişisel verilerin korunması" ; fy:dayanak fy:Madde_4_2 ;
    rdfs:comment "Özel ve aile hayatına saygı ile kişisel verilerin rızasız işlenmemesi hakkı." ;
    fy:anahtarKelime "kamera", "izlensin", "kayıt altına alınsın", "fişlensin", "kimlik bilgisi", "kişisel veri" .
fy:KatilimHakki a fy:TemelHak ; rdfs:label "Katılım ve oy hakkı" ; fy:dayanak fy:Madde_4_1 ;
    fy:cekirdekDegistirilemez true ;
    rdfs:comment "Her üyenin öneri verme, tartışmaya katılma ve eşit oy kullanma hakkı. Özü oylanamaz." ;
    fy:anahtarKelime "oy hakkı", "oy kullanamasın", "üyelikten çıkarılsın", "katılamasın" .
fy:MulkiyetHakki a fy:TemelHak ; rdfs:label "Mülkiyet hakkı" ; fy:dayanak fy:Madde_4_2 ;
    rdfs:comment "Mülk edinme, kullanma ve ondan yararlanma hakkı." ;
    fy:anahtarKelime "kamulaştırma", "el konulsun", "yıkılsın", "mülk" .
fy:ToplanmaHakki a fy:TemelHak ; rdfs:label "Toplanma ve örgütlenme hakkı" ; fy:dayanak fy:Madde_4_2 ;
    rdfs:comment "Barışçıl toplantı ve gösteri düzenleme, dernek kurma ve üye olma hakkı." ;
    fy:anahtarKelime "toplantı yasağı", "gösteri", "eylem", "dernek" .
fy:ErisimHakki a fy:TemelHak ; rdfs:label "Hizmetlere erişim hakkı" ; fy:dayanak fy:Madde_4_2 ;
    rdfs:comment "Kamusal hizmet ve alanlardan eşit ve engelsiz yararlanma hakkı." ;
    fy:anahtarKelime "kapatılsın", "kaldırılsın", "ücretli olsun", "erişim", "hizmet durdurulsun" .
fy:SaglikHakki a fy:TemelHak ; rdfs:label "Sağlık hakkı" ; fy:dayanak fy:Madde_4_2 ;
    rdfs:comment "Sağlık hizmetlerine erişim ve bedensel bütünlüğün korunması hakkı." ;
    fy:anahtarKelime "sağlık hizmeti", "aşı zorunlu", "tedavi" .

# ═════════════════════════ Silme gerekçeleri ve içerik etiketleri ═════════════════════════
# İçerik etiketleri silme gerekçeleriyle aynı IRI'yi paylaşır (fy:IcerikEtiketi ve fy:SilmeGerekcesi).

fy:KisiselVeriIfsasi a fy:SilmeGerekcesi, fy:IcerikEtiketi ; rdfs:label "Kişisel veri ifşası" ; fy:icerikEtiketiAdi "Kişisel veri ifşası" ;
    rdfs:comment "Bir kişinin kimlik, adres, telefon, sağlık vb. verilerinin rızası dışında paylaşılması." ;
    fy:acil true ; fy:muhurlu true ; fy:dayanak fy:Madde_20_1 .
fy:Tehdit a fy:SilmeGerekcesi, fy:IcerikEtiketi ; rdfs:label "Tehdit" ; fy:icerikEtiketiAdi "Tehdit" ;
    rdfs:comment "Bir kişiye ya da gruba yönelik şiddet veya zarar tehdidi." ;
    fy:acil true ; fy:dayanak fy:Madde_20_1 .
fy:HakaretIftira a fy:SilmeGerekcesi, fy:IcerikEtiketi ; rdfs:label "Hakaret / iftira" ; fy:icerikEtiketiAdi "Hakaret / iftira" ;
    rdfs:comment "Kişilik haklarına saldırı, asılsız suçlama." ;
    fy:dayanak fy:Madde_20_1 .
fy:NefretSoylemi a fy:SilmeGerekcesi, fy:IcerikEtiketi ; rdfs:label "Korunan gruba nefret söylemi" ; fy:icerikEtiketiAdi "Nefret söylemi" ;
